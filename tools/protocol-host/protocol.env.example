# Copy to /etc/xke/protocol.env and replace the placeholder API key.
# EnvironmentFile syntax: NAME=value, no shell export statements.
XKE_PROTOCOL_API_KEY=<REPLACE_WITH_YOUR_API_KEY>
XKE_PROTOCOL_DATA_DIR=/var/lib/xke-protocol
XKE_PROTOCOL_URLS=http://127.0.0.1:38444
XKE_DDDDOCR_URL=http://127.0.0.1:8866/recognize
