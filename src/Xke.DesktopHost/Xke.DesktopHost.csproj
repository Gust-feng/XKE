<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Xke.DesktopHost</RootNamespace>
    <AssemblyName>Xke.DesktopHost</AssemblyName>
    <AssemblyTitle>XKE·软大课务</AssemblyTitle>
    <Product>XKE·软大课务</Product>
    <Description>XKE·软大课务桌面客户端</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <ProjectReference Include="..\Xke.Contracts\Xke.Contracts.csproj" />
    <ProjectReference Include="..\Xke.Core\Xke.Core.csproj" />
    <ProjectReference Include="..\Xke.Storage\Xke.Storage.csproj" />
    <ProjectReference Include="..\Xke.WebHost\Xke.WebHost.csproj" />
  </ItemGroup>
</Project>
