<Window x:Class="Xke.DesktopHost.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课前提醒" Width="398" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        UseLayoutRounding="True" MouseEnter="Pause" MouseLeave="Resume">
    <!-- 主题刷子：控件只引用资源，后期深色主题整体替换这一组即可 -->
    <Window.Resources>
        <SolidColorBrush x:Key="NotifyCardBackground" Color="#F2F1EC"/>
        <SolidColorBrush x:Key="NotifyCardBorder" Color="#121211"/>
        <SolidColorBrush x:Key="NotifyTextPrimary" Color="#121211"/>
        <SolidColorBrush x:Key="NotifyTextMuted" Color="#7D7C76"/>
        <SolidColorBrush x:Key="NotifyAccent" Color="#E8291C"/>
        <Style TargetType="Button">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="10">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#000000"/></Border.Effect>
        <!-- 主界面「下一节」卡的浅色镜像：整卡可点打开课表，右上角关闭 -->
        <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource NotifyCardBackground}" BorderBrush="{DynamicResource NotifyCardBorder}"
                BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnCardOpen" AutomationProperties.Name="查看课表">
            <StackPanel Margin="16,14,16,16">
                <Grid>
                    <StackPanel x:Name="Kicker" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource NotifyAccent}" VerticalAlignment="Center"/>
                        <TextBlock Text="课前提醒" Margin="8,0,0,0" FontSize="11" FontWeight="Bold" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource NotifyTextMuted}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="24" Height="22" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NotifyTextMuted}" FontSize="12"
                            Click="Dismiss" ToolTip="关闭提醒" AutomationProperties.Name="关闭提醒" Content="&#x2715;"/>
                </Grid>
                <!-- 课程提醒：与设置弹窗示意卡同构——"N 分钟"整行信号红，课程与教室紧凑成组 -->
                <Grid x:Name="HeroPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 数字是第一视觉：44px 特大红，单位与数字同一基线（Run 内联共享基线，不再各自对齐） -->
                    <TextBlock Grid.Row="0" FontWeight="Bold" Foreground="{DynamicResource NotifyAccent}" LineStackingStrategy="BlockLineHeight" LineHeight="52">
                        <Run x:Name="Countdown" FontFamily="Segoe UI" FontSize="44"/>
                        <Run Text=" 分钟" FontSize="20" FontFamily="Microsoft YaHei UI"/>
                    </TextBlock>
                    <TextBlock x:Name="CourseName" Grid.Row="1" Margin="0,8,0,0" FontSize="17" LineHeight="24" FontWeight="Bold" FontFamily="Microsoft YaHei UI"
                               Foreground="{DynamicResource NotifyTextPrimary}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Room" Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Left" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                   Foreground="{DynamicResource NotifyTextMuted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource NotifyAccent}" Text="查看课表"/>
                    </Grid>
                </Grid>

                <!-- 通用通知回退 -->
                <StackPanel x:Name="SimplePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource NotifyTextPrimary}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Message" Margin="0,6,0,0" FontSize="13" LineHeight="20" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource NotifyTextMuted}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                    <TextBlock HorizontalAlignment="Right" Margin="0,10,0,0" FontSize="12" FontWeight="Bold" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource NotifyAccent}" Text="查看课表"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
